# Public (browser-safe). Without both, the dashboard shows a "Connect Supabase" notice and nothing is editable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site URL ("View site" link, draft previews and cache refresh)
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000
# Shared secret for the public site's /api/revalidate (same value in both apps). Unset = edits are saved but the live site is not refreshed.
REVALIDATE_SECRET=
