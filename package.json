{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:client": "npm run dev -w @portfolio/client",
    "dev:admin": "npm run dev -w @portfolio/admin",
    "build": "npm run build -w @portfolio/client -w @portfolio/admin",
    "lint": "eslint . && npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit",
    "seed:legacy": "tsx scripts/seed-from-legacy.ts",
    "seed:push": "tsx scripts/push-seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "~16.4.0",
    "node-html-parser": "^9.0.4",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
