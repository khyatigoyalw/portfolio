# Public (browser-safe). When both are set the site reads from Supabase; otherwise from content/seed.json.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical site URL (sitemap, og tags, redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side scripts only (scripts/push-seed.ts). NEVER expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=
# Contact form email (Resend). Without RESEND_API_KEY messages are still saved, just not emailed.
RESEND_API_KEY=
# Recipient; falls back to the contact email in Profile & settings
CONTACT_NOTIFY_EMAIL=
# Sender; the default only delivers to your own Resend account email until you verify a domain
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
