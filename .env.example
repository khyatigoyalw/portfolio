# Public (browser-safe). When both are set the site reads from Supabase; otherwise from content/seed.json.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical site URL (sitemap, og tags, redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side scripts only (scripts/push-seed.ts). NEVER expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=
